@model IEnumerable<NguyenGiaDuy_2310900031.Models.NgdEmployee>

@{
    ViewData["Title"] = "Quan li nhan vien";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>@ViewData["Title"]</h1>
    <p>
        <a asp-action="NgdCreate" class="btn btn-primary">Thêm mới nhân viên</a>
    </p>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NgdEmpId)</th>
            <th>@Html.DisplayNameFor(model => model.NgdEmpName)</th>
            <th>@Html.DisplayNameFor(model => model.NgdEmpLevel)</th>
            <th>@Html.DisplayNameFor(model => model.NgdEmpStartDate)</th>
            <th>@Html.DisplayNameFor(model => model.NgdEmpStatus)</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NgdEmpId</td>
                <td>@item.NgdEmpName</td>
                <td>@item.NgdEmpLevel</td>
                <td>@(item.NgdEmpStartDate.HasValue ? item.NgdEmpStartDate.Value.ToString("dd/MM/yyyy") : "")</td>
                <td>
                    @if (item.NgdEmpStatus == true)
                    {
                        <span class="badge bg-success">Show</span>
                    }
                    else if (item.NgdEmpStatus == false)
                    {
                        <span class="badge bg-danger">Hide</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa rõ</span>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="NgdEdit" asp-route-ngdId="@item.NgdEmpId" class="btn btn-success btn-sm">Edit</a>
                        <a asp-action="NgdDetails" asp-route-ngdId="@item.NgdEmpId" class="btn btn-primary btn-sm">Details</a>
                        <a asp-action="NgdDelete" asp-route-ngdId="@item.NgdEmpId" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

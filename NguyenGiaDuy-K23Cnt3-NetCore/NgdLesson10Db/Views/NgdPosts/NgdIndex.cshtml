@model IEnumerable<NgdLesson10Db.Models.NgdPost>

@{
    ViewData["Title"] = "Quan li bai viet";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>@ViewData["Title"]</h1>
    <p>
    <a asp-action="NgdCreate" class="btn btn-primary">Them moi</a>
    </p>
</div>

<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NgdId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgdTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgdImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgdContent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgdStatus)
            </th>
            <th>Chuc nang</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.NgdId)

            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NgdTitle)
                <img src="@item.NgdImage" style="width:50px"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NgdImage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NgdContent)
            </td>
                <td class="d-flex justify-content-between align-items-center">
               
                    @if (item.NgdStatus == true)
                    {
                        <span class="badge bg-success">Hien thi</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Tam an</span>
                    }
                </td>
            <td>
                <a asp-action="NgdEdit" asp-route-ngdId="@item.NgdId" class="btn btn-success">Edit</a> |
                    <a asp-action="NgdDetails" asp-route-ngdId="@item.NgdId" class="btn btn-info">Details</a> |
                    <a asp-action="NgdDelete" asp-route-ngdId="@item.NgdId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

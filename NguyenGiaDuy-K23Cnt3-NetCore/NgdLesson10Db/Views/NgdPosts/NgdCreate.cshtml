@model NgdLesson10Db.Models.NgdPost

@{
    ViewData["Title"] = "Thêm mới bài viết";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header">
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <form asp-action="NgdCreate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NgdTitle" class="form-label"></label>
                <input asp-for="NgdTitle" class="form-control" />
                <span asp-validation-for="NgdTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgdImage" class="form-label"></label>
                <input asp-for="NgdImage" class="form-control" type="file" />
                <span asp-validation-for="NgdImage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgdContent" class="form-label"></label>
                <textarea asp-for="NgdContent" class="form-control" rows="5"></textarea>
                <span asp-validation-for="NgdContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgdStatus" class="form-label"></label>
                <select asp-for="NgdStatus" class="form-select">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="false">Tạm ẩn</option>
                    <option value="true">Hiển thị</option>
                </select>
                <span asp-validation-for="NgdStatus" class="text-danger"></span>
            </div>


            <div class="d-flex justify-content-between">
                <a asp-action="NgdIndex" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary">Ghi lại</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
